# LeadForge — copy to .env and fill in
# (never commit the real .env!)

# LLM access for copy generation / agents
OPENROUTER_API_KEY=sk-or-...

# Telegram ops bot (self-hosted)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_USERS=your_id,partner_id
TELEGRAM_CHAT_ID=dm_chat_id
TELEGRAM_GROUP_CHAT_ID=-100...group id

# GitHub deployer
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your_username
